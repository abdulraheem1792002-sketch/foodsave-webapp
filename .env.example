# ===================================================
# FOODSAVE / FLASHFRUIT PAKISTAN — ENVIRONMENT TEMPLATE
# ===================================================

# Server & Port
NODE_ENV=production
PORT=5000
VITE_API_BASE_URL=https://api.foodsave.pk/api
CLIENT_URL=https://www.foodsave.pk

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/foodsave_db?retryWrites=true&w=majority

# JWT Security
JWT_SECRET=your_jwt_secret_key

# Payment Gateways (JazzCash / EasyPaisa)
JAZZCASH_MERCHANT_ID=MC_YOUR_MERCHANT_ID
JAZZCASH_PASSWORD=your_password
JAZZCASH_INTEGRITY_SALT=your_salt_key

EASYPAISA_STORE_ID=your_store_id
EASYPAISA_HASH_KEY=your_hash_key

# Bykea Logistics API
BYKEA_PARTNER_API_KEY=your_bykea_partner_key
